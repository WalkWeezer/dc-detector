# Copy to .env for local overrides

# Backend
PORT=8080
DETECTIONS_DIR=data/detections
JSON_LIMIT=25mb
LOG_FORMAT=dev
# URL Detection Service (запускается отдельно от Docker)
# На том же хосте: http://localhost:8001
# На другом хосте: http://<IP>:8001
# В Docker на Windows/Mac: http://host.docker.internal:8001
DETECTION_URL=http://localhost:8001

# Detection Service (запускается отдельно, не в Docker)
# Переменные окружения для detection_server.py:
CAMERA_INDEX=0
CONFIDENCE_THRESHOLD=0.5
INFER_FPS=5
PORT=8001
# Трансформации изображения
# ROTATE_ANGLE: 0, 90, 180, 270 (поворот на градусы)
# FLIP_HORIZONTAL: true/false (горизонтальный переворот)
# FLIP_VERTICAL: true/false (вертикальный переворот)
ROTATE_ANGLE=0
FLIP_HORIZONTAL=false
FLIP_VERTICAL=false
# MavLink GPS настройки
# Аппаратный UART на GPIO (Raspberry Pi): /dev/ttyAMA0 или /dev/serial0 (GPIO 14/15)
# Software UART на GPIO: /dev/ttyAMA2 или /dev/ttyAMA3 (настроенные через config.txt)
# Для USB последовательного порта: /dev/ttyUSB0 или COM3 (Windows)
# Для UDP: udp:127.0.0.1:14550
# Для TCP: tcp:192.168.1.100:5760
# Оставьте пустым для отключения GPS
MAVLINK_PORT=
MAVLINK_BAUDRATE=57600

[Unit]
Description=DC-Detector Application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dc-detector
# Используем docker-compose.prod.yml
ExecStart=/bin/bash -c 'docker compose -f /opt/dc-detector/docker-compose.prod.yml up -d'
ExecStop=/bin/bash -c 'docker compose -f /opt/dc-detector/docker-compose.prod.yml down --remove-orphans'
ExecReload=/bin/bash -c 'docker compose -f /opt/dc-detector/docker-compose.prod.yml restart'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


[Unit]
Description=DC-Detector Application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dc-detector
# Используем compose-helper для единообразного выбора compose файлов
ExecStart=/bin/bash -c 'source /opt/dc-detector/scripts/compose-helper.sh && COMPOSE_ARGS=$(get_compose_files /opt/dc-detector prod) && docker compose $COMPOSE_ARGS up -d'
ExecStop=/bin/bash -c 'source /opt/dc-detector/scripts/compose-helper.sh && COMPOSE_ARGS=$(get_compose_files /opt/dc-detector prod) && docker compose $COMPOSE_ARGS down --remove-orphans'
ExecReload=/bin/bash -c 'source /opt/dc-detector/scripts/compose-helper.sh && COMPOSE_ARGS=$(get_compose_files /opt/dc-detector prod) && docker compose $COMPOSE_ARGS restart'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


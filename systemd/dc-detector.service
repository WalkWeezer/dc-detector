[Unit]
Description=DC-Detector Application
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=pi
Group=pi
WorkingDirectory=/opt/dc-detector
# Устанавливаем переменные окружения для неинтерактивного режима
Environment="DEBIAN_FRONTEND=noninteractive"
Environment="SYSTEMD=1"
# Запускаем скрипт start-prod.sh
ExecStart=/bin/bash /opt/dc-detector/scripts/start-prod.sh
ExecStop=/bin/bash /opt/dc-detector/scripts/stop-prod.sh
StandardOutput=journal
StandardError=journal
# Таймаут для запуска (скрипт может долго работать)
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

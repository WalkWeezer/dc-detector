[Unit]
Description=DC-Detector Application
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Базовые переменные, которые можно переопределить в /etc/dc-detector.env
Environment=PROJECT_ROOT=/opt/dc-detector
Environment=DETECTION_START_INITIAL_SLEEP=20
Environment=DETECTION_HEALTH_ATTEMPTS=12
Environment=DETECTION_HEALTH_DELAY=10
Environment="DEBIAN_FRONTEND=noninteractive"
Environment="SYSTEMD=1"
EnvironmentFile=-/etc/dc-detector.env
WorkingDirectory=%E{PROJECT_ROOT}
# Даём системе прогреться перед запуском
ExecStartPre=/bin/sleep 15
# Запуск и остановка скриптов управления
ExecStart=/bin/bash %E{PROJECT_ROOT}/scripts/start-prod.sh
ExecStop=/bin/bash %E{PROJECT_ROOT}/scripts/stop-prod.sh
StandardOutput=journal
StandardError=journal
# Перезапускаем, если скрипт завершился с ошибкой (например, камера не успела подняться)
Restart=on-failure
RestartSec=20
# Таймауты: запуск может занимать несколько минут, остановка — до 90 секунд
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target

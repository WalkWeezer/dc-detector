[Unit]
Description=DC-Detector Application
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/dc-detector
ExecStart=/bin/sh -c 'if [ -f docker-compose.pi-standalone.yml ]; then docker compose -f docker-compose.pi-standalone.yml up -d; else docker compose -f docker-compose.yml -f docker-compose.pi.yml up -d; fi'
ExecStop=/bin/sh -c 'if [ -f docker-compose.pi-standalone.yml ]; then docker compose -f docker-compose.pi-standalone.yml down; else docker compose -f docker-compose.yml -f docker-compose.pi.yml down; fi'
ExecReload=/bin/sh -c 'if [ -f docker-compose.pi-standalone.yml ]; then docker compose -f docker-compose.pi-standalone.yml restart; else docker compose -f docker-compose.yml -f docker-compose.pi.yml restart; fi'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target


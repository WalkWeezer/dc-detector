#
# Конфигурация для systemd-сервиса dc-detector (копируйте в /etc/dc-detector.env)
#
# PROJECT_ROOT — абсолютный путь к репозиторию на устройстве
PROJECT_ROOT=/home/admin/dc-detector

# Сколько секунд ждать перед первой проверкой Detection Service
DETECTION_START_INITIAL_SLEEP=20

# Сколько попыток health-check выполнять (каждая попытка — через DETECTION_HEALTH_DELAY секунд)
DETECTION_HEALTH_ATTEMPTS=12
DETECTION_HEALTH_DELAY=10

# Значения по умолчанию можно оставить, если проект находится в /opt/dc-detector

